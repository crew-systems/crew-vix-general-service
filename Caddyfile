{
    admin off
    persist_config off
    auto_https off
}

:{$PORT:80} {
    root * /app/dist
    encode zstd gzip

    # Hashed static assets - cache forever, never fallback to index.html
    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Public media (hero video, posters, project photos). Without this block
    # they fell through to the SPA fallback: sent as no-store (phones re-downloaded
    # the hero video on every visit) and missing files returned index.html.
    # Names are not hashed: cache for one day, then revalidate via ETag.
    # When replacing an image or video, give it a NEW file name - overwriting
    # keeps returning visitors on the old file until the cache expires.
    @media path /images/* /videos/*
    handle @media {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # Static root files (favicon, robots, sitemap, llms)
    @static path /favicon.* /robots.txt /sitemap.xml /llms.txt /llms-full.txt /placeholder.svg
    handle @static {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # SPA Entrypoint - never cache so clients always get latest asset hashes
    handle /index.html {
        header Cache-Control "no-store, no-cache, must-revalidate"
        file_server
    }

    # SPA Fallback for client-side routes (/services, /thank-you, etc.)
    handle {
        header Cache-Control "no-store, no-cache, must-revalidate"
        try_files {path} /index.html
        file_server
    }
}
